<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data out of cloud backup and device-to-device
     transfer, for the same reason as android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
